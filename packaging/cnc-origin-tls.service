[Unit]
Description=cnc origin HTTPS certificate renewal
After=nginx.service cnc-nginx.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=-/etc/cnc.env
WorkingDirectory=/var/lib/cnc/current
ExecStart=/var/lib/cnc/current/.venv/bin/python -m app.services.origin_tls
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/cnc
TimeoutStartSec=120
