[Unit]
Description=cnc Cloudflare domain reconciliation
After=network-online.target cnc-admin.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/var/lib/cnc/current
EnvironmentFile=-/etc/cnc.env
ExecStart=/var/lib/cnc/current/.venv/bin/cnc-admin cloudflare domains sync
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/cnc /var/log/cnc
TimeoutStartSec=300
