[Unit]
Description=cnc backend health alerts
After=network-online.target cnc-admin.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/var/lib/cnc/current
EnvironmentFile=-/etc/cnc.env
ExecStart=/var/lib/cnc/current/.venv/bin/cnc-admin backend-alerts check
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc /etc/containers/systemd /usr/local/bin /var/lib/cnc /var/log/cnc
