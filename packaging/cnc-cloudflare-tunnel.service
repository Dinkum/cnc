[Unit]
Description=cnc Cloudflare Tunnel connector
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
WorkingDirectory=/var/lib/cnc/current
EnvironmentFile=-/etc/cnc.env
ExecStart=/var/lib/cnc/current/.venv/bin/python -m app.services.cloudflare_tunnel
ExecStop=-/usr/bin/env podman stop --time 15 cnc-cloudflare-tunnel
Restart=always
RestartSec=3
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
